# Copy to .env.local for development. Replace placeholders with your own values.
# Never commit real keys. Public variables are embedded into the browser build.

# REQUIRED: browser-public authentication and database configuration.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
NEXT_PUBLIC_CONVEX_URL=https://REPLACE_ME.convex.cloud

# REQUIRED: server-only authentication, model, signed-photo and credit credentials.
CLERK_SECRET_KEY=sk_test_REPLACE_ME
GEMINI_API_KEY=REPLACE_ME
GOOGLE_PLACE_API_KEY=REPLACE_ME
# Use a cryptographically random value (at least 32 characters); set the SAME
# value in the web host and the Convex backend environment. Do not expose it.
TRIP_CREDIT_SECRET=REPLACE_WITH_A_RANDOM_SERVER_ONLY_VALUE

# REQUIRED for interactive maps: a PUBLIC, URL-restricted Mapbox token.
NEXT_PUBLIC_MAPBOX_API_KEY=pk.REPLACE_ME

# REQUIRED IN PRODUCTION: the real HTTPS origin (no path or trailing route).
# Used for canonical, sitemap and social URLs. Leave blank in local development.
SITE_URL=

# OPTIONAL: preserve the existing model unless deliberately changed by an operator.
GEMINI_MODEL=gemini-3.5-flash-lite

# OPTIONAL: explicit public Clerk routes and fallback redirects.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/create-new-trip

# CONVEX CLI only: set when linking/deploying a Convex project (not browser-public).
# Obtain this from your own Convex project; do not copy a development project ID.
CONVEX_DEPLOYMENT=

# CONVEX BACKEND environment (configure in Convex, not only the web host):
# CLERK_JWT_ISSUER_DOMAIN=https://your-production-clerk-issuer.example
# TRIP_CREDIT_SECRET=<the same server-only value used by the web host>
